# helm 控制台 + API 的 TLS 终结与静态资源托管（Caddy v2）
#
# 容器方式（默认，compose 里的 caddy 服务）：反代上游 = server:8080
# 宿主方式（apt/brew 装 caddy）：
#   HELM_UPSTREAM=127.0.0.1:8080 HELM_CONSOLE_ROOT=/绝对路径/helm/console/dist caddy run \
#       --config deploy/prod/Caddyfile
#
# 站点地址由环境变量 HELM_SITE_ADDR 驱动（compose 从 .env 读进 caddy 容器）：
#   生产：填你的域名（A 记录需已指向本机、80/443 可达）→ Caddy 自动申请 Let's Encrypt 证书
#   本地验栈：HELM_SITE_ADDR=localhost → Caddy 用内部 CA 自签，不碰 Let's Encrypt
# 另需按需改：若控制台不在同一台机器上托管，删掉 handle 块里的 root/try_files/file_server

{$HELM_SITE_ADDR:ops.example.com} {
	encode zstd gzip

	# 安全响应头（mTLS 之外的传输层加固）
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}

	# API 与 MCP：反代到 helm-server（含 WS 实时流与终端，Caddy 原生透传 WebSocket）
	handle /api/* {
		reverse_proxy {$HELM_UPSTREAM:server:8080}
	}
	handle /mcp {
		reverse_proxy {$HELM_UPSTREAM:server:8080}
	}
	handle /healthz {
		reverse_proxy {$HELM_UPSTREAM:server:8080}
	}

	# 控制台静态资源（console 构建产物）+ SPA fallback
	handle {
		root * {$HELM_CONSOLE_ROOT:/srv/helm-console}
		try_files {path} /index.html
		file_server
	}
}

# ---------------------------------------------------------------------------
# 可选：让 Agent 的 gRPC 也走 Caddy（TLS 终结 → h2c 明文回源）
#
# ⚠ 代价：Caddy 终结 TLS 后，服务端看不到客户端证书 → HELM_MTLS 失效
#   （只剩 token 认证）。要 mTLS 就让 Agent 直连 :50051，不要启用本块。
#   仅当你需要统一走 443/8443、或不想单独放行 50051 时使用。
#
# agent.example.com:8443 {
# 	reverse_proxy h2c://server:50051
# }
