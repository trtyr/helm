# helm 生产环境变量模板
#
#   用法：cd deploy/prod && cp env.example .env && vi .env
#   生成强随机值：openssl rand -hex 32
#
# 必改 3 处：POSTGRES_PASSWORD / HELM_SERVER_TOKEN / HELM_JWT_SECRET
# 改完靠 HELM_REQUIRE_STRONG_DEFAULTS=true 让「忘了改」直接启动失败（否则只打 ERROR 日志）。
# 默认值与其余可选参数的口径见 engram《部署与运维》§5。

# ---- 数据库（compose 内的 postgres 服务）----
POSTGRES_USER=helm
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_hex_32
POSTGRES_DB=helm

# ---- Server 凭据（A1/A2）----
# Agent 注册 token 与 /api/v1/agents/cert 同源；泄漏 = 可注册伪 Agent
HELM_SERVER_TOKEN=CHANGE_ME_openssl_rand_hex_32
# 不停机轮换位：新旧 token 并存 → Agent 分批改配置 → 清空本行
HELM_SERVER_TOKENS=
# JWT 签名密钥；泄漏 = 可伪造登录态
HELM_JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
# 取值（Q006 起）：推荐 true，兼容 1/0/yes/no；写别的（如 on 之外的乱值）会被 clap 判非法
HELM_REQUIRE_STRONG_DEFAULTS=true

# ---- mTLS（建议开启；tls_dir 已由 compose 固定为 /app/tls）----
# 取值同上传布尔口径（推荐 true，兼容 1/0/yes/no）；Agent 侧需 HELM_CERT_DIR 指向证书目录
HELM_MTLS=true
# 证书 SAN 名：Agent 用它校验服务端证书，填对外域名（或签发时写进 SAN 的 IP）
HELM_TLS_SERVER_NAME=ops.example.com
# Caddy 站点地址（Caddyfile 用；填域名则自动申请 Let's Encrypt；本地验栈可填 localhost）
HELM_SITE_ADDR=ops.example.com

# ---- 运行参数（默认值即生产可用，按需覆盖）----
HELM_LOG=info
HELM_HEARTBEAT_TIMEOUT=30
HELM_JOB_TIMEOUT_SECS=300
# 时序与历史表保留天数：metrics/alerts/notifications/jobs/audit_logs/file_transfers/status_events
# （status_events 自 T008 起纳入；IR 取证表不在其列，需单独策略）
HELM_RETENTION_DAYS=90
HELM_MCP_TIER=2
HELM_OFFLINE_ALERT_MINS=30
# IR 取证表保留（T009）：快照按「每主机条数」封顶；页面缓存按未刷新天数清（0 = 不清理）
HELM_IR_SNAPSHOT_KEEP_PER_AGENT=20
HELM_IR_PAGE_CACHE_TTL_DAYS=30
HELM_DB_MAX_CONNECTIONS=10
HELM_DB_ACQUIRE_TIMEOUT=30
HELM_SESSION_IDLE_TIMEOUT=300
